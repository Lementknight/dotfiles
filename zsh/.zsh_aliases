# ============================================================================
# Aliases
# ============================================================================

# List files with colorls
alias cls='colorls --sd --color=always --hyperlink'

# YouTube download
alias youtube-to-audio='yt-dlp'

alias youtube-audio-cleanup='for file in *.opus; do ffmpeg -i "$file" -c:a libmp3lame -q:a 0 "${file%.opus}.mp3"; rm *.opus; done;'
# Emacs no window
alias enw='emacs -nw'

alias pdf-preview='qlmanage -p'

alias fix-gpg='rm -rf ~/.gnupg/*.lock | rm -rf ~/.gnupg/public-keys.d/*.lock'

# I'll be doing another one for Linux, but this one will give you 
# a pop up notification and sound alert (using the built-in sounds for macOS)

# Requires https://github.com/caarlos0/timer and https://github.com/julienXX/terminal-notifier to be installed

# Mac setup for pomo
alias work="timer 60m && terminal-notifier -message 'Pomodoro'\
        -title 'Work Timer is up! Take a Break 😊'\
        -appIcon '~/Pictures/pumpkin.png'\
        -sound Crystal"
        
alias rest="timer 10m && terminal-notifier -message 'Pomodoro'\
        -title 'Break is over! Get back to work 😬'\
        -appIcon '~/Pictures/pumpkin.png'\
        -sound Crystal"
